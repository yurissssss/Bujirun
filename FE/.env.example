# 이 파일을 복사해 .env.local을 만들고 실제 값을 채워주세요.
# cp .env.example .env.local

# 백엔드 API 베이스 URL
# 로컬 백엔드를 띄워 쓰는 경우: http://localhost:8080
# 운영 서버로 붙는 경우: https://api.bujirun.store
NEXT_PUBLIC_API_BASE_URL=https://api.bujirun.store

# 배포된 프론트엔드 주소 (공유 초대 링크·OG 이미지·메타데이터에 사용)
NEXT_PUBLIC_APP_URL=https://bujirun.store

# 부지런-node (Yjs 실시간 협업 WebSocket 서버) 주소
# 로컬에서 bujirun-node를 직접 띄운 경우: ws://localhost:1234
# 운영 서버로 붙는 경우: wss://bujirun.store/ws (백엔드 확인 완료, 2026-07-23)
#   실제 연결 URL은 y-websocket이 여기에 "/{itineraryId}?token=..."을 붙여서
#   wss://bujirun.store/ws/{itineraryId}?token={accessToken} 형태로 만든다.
#   (Vercel 등 실제 배포 환경변수에도 이 값으로 설정 필요 — 아직 미설정 상태일 수 있음)
NEXT_PUBLIC_YJS_WS_URL=ws://localhost:1234

# true면 이 프론트가 REST flush를 전혀 하지 않고 node-yjs 서버(RoomFlushManager)가 전담한다.
# false(또는 미설정)면 예전처럼 이 프론트가 직접 flush한다 — 문제가 생기면 이 값만 false로
# 되돌려서 즉시 롤백할 수 있다(3단계, 2026-09-17).
NEXT_PUBLIC_SERVER_SIDE_FLUSH=false

# 카카오 로그인
# 카카오 디벨로퍼스 콘솔의 "카카오 로그인 > Redirect URI"에 아래 값과 정확히 같은 URI가
# 등록돼 있어야 함 (안 맞으면 콜백에서 400) — 로컬/운영 각각 등록 필요.
# 로컬: http://localhost:3000/auth/kakao/callback
# 운영(Vercel Production 배포 도메인 기준): https://bujirun-frontend.vercel.app/auth/kakao/callback
#   (커스텀 도메인 연결 시 그 도메인으로 다시 갱신 필요 — 2026-07-28 기준 Vercel 기본 도메인 사용 중)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 카카오맵 (카카오 디벨로퍼스 앱의 JavaScript 키 — 카카오톡 공유에도 동일한 키가 재사용됨)
# 카카오톡 공유를 쓰려면 JavaScript SDK 도메인 등록과 별도로
# 앱 > 제품 링크 관리 > 웹 도메인에 NEXT_PUBLIC_APP_URL의 도메인도 등록해야 함.
# 미등록 시 카카오가 웹 링크를 제거해 PC에서 "모바일에서 확인해 주세요"로 표시될 수 있음.
NEXT_PUBLIC_KAKAO_MAP_KEY=
